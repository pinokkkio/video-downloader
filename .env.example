# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Необязательные настройки:
# Кому разрешено пользоваться ботом (Telegram user id через запятую). Пусто — всем.
ALLOWED_USERS=
# Команда для скачивания
YTDLP_CMD=yt-dlp-proxy
# Максимальная высота видео
MAX_HEIGHT=720
# Лимит размера файла, МБ (50 — ограничение облачного Bot API)
MAX_FILE_MB=50
# Адрес локального telegram-bot-api сервера (позволяет слать файлы до 2000 МБ)
BOT_API_URL=
# Таймаут скачивания, сек.
DOWNLOAD_TIMEOUT=600
# Сколько видео качать одновременно
MAX_PARALLEL=2
