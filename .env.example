# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Ключи приложения с https://my.telegram.org -> API development tools
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Необязательные настройки:
# Кому разрешено пользоваться ботом (Telegram user id через запятую). Пусто — всем.
ALLOWED_USERS=
# Максимальная высота видео
MAX_HEIGHT=720
# Лимит размера файла, МБ (больше 2000 Telegram не примет)
MAX_FILE_MB=2000
# Таймаут скачивания, сек.
DOWNLOAD_TIMEOUT=1800
# Сколько видео качать одновременно
MAX_PARALLEL=2
