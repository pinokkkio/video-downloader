# systemd user-сервис. Установка: см. README.md
[Unit]
Description=Telegram video downloader bot
After=network-online.target

[Service]
WorkingDirectory=%h/video-downloader
ExecStart=%h/video-downloader/.venv/bin/python bot.py
# yt-dlp-proxy должен быть доступен в PATH
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
